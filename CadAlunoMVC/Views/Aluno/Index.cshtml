<!-- definindo tipo do objeto Model -->
@model List<AlunoViewModel>

<!-- carregando layout pre-definido -->
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Listagem de Aluno";
}
<h2>@ViewData["Title"]</h2>

<!-- o link seguinte depende da existencia de:
    * uma Controller chamado Aluno
    * uma Action (método) chamado create
-->

<br />
<a href="/aluno/create">Novo Registro</a>
<br />

<table class="table table-responsive">

<!-- Usaremos o Bootstrap:
    biblioteca nativa para configurações de elementos visuais -->

    <tr> <!-- table row -->

        <th>Ações</th> <!-- table header -->
        <th>RA</th>
        <th>Nome</th>
        <th>Data de nascimento</th>

    </tr>

    @foreach (var aluno in Model)
    {
        <tr> <!-- table row -->

            <!-- table data -->
            <td><a href="/aluno/Edit?id=@aluno.Id">Editar</a> </td>
            <td>@aluno.Id</td>
            <td>@aluno.Nome</td>
            <td>@aluno.DataNascimento.ToShortDateString()</td>
            <td>@aluno.CidadeId</td>

            @{/*   "Mensalidade?"  ->  se Mensalidade != null, executa o comando à frente */}
            <td>@aluno.Mensalidade?.ToString("c")</td>

        </tr>
    }
</table>
